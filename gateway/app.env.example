# Merge into the HOST APP .env; do not replace existing keys/settings.
# Gateway upstream timeout 60s x two attempts < router125 < client130.
# Whole roles allow two model requests (one repair) plus overhead.
LLM_PROVIDER=openai-compatible
LLM_MODEL=research-primary
LLM_BASE_URL=http://127.0.0.1:4000/v1
# Supply the gateway master key as LLM_API_KEY locally, never an upstream key.
LLM_GATEWAY_OBSERVATION=1
LLM_REQUEST_TIMEOUT=130
LISTENER_TIMEOUT=270
PLANNER_TIMEOUT=270
RESEARCHER_TIMEOUT=600
REPORTER_TIMEOUT=270
EVALUATOR_TIMEOUT=270
RUN_TIMEOUT=1800
# Empty means unknown pricing. No provider prices are assumed.
LLM_TOKEN_PRICES_JSON={}
