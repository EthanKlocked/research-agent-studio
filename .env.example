LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=8192
# Timeouts in seconds: finite, greater than zero, at most 7200.
# Per HTTP/model request (not the complete tool/repair loop).
LLM_REQUEST_TIMEOUT=30
# Whole role calls, including tool loops and one JSON repair.
LISTENER_TIMEOUT=60
PLANNER_TIMEOUT=60
RESEARCHER_TIMEOUT=180
REPORTER_TIMEOUT=60
EVALUATOR_TIMEOUT=60
# Total workflow across all revisions.
RUN_TIMEOUT=600
RESEARCH_TEST_MODE=0
# Optional official Apple public documents; no API key. Requires pdftotext for PDF.
RESEARCH_PUBLIC_SOURCES=0
RESEARCH_PDFTOTEXT=
