# Optional general research; disabled until both fields are configured.
# Operator must disable paid recharge / enforce free credits in the Exa account.
# Local request caps do not guarantee a free balance. Never share this key.
SEARCH_PROVIDER=exa
EXA_API_KEY=
# Optional gateway: merge gateway/app.env.example for coherent request/role/run budgets.
# See docs/gateway.md and gateway/.env.example.
LLM_GATEWAY_OBSERVATION=0
LLM_TOKEN_PRICES_JSON={}
# These remain blank: use the gateway alias/base URL/key instead of upstream values.
# Upstream keys belong only in gateway/.env, never the browser.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=8192
# Timeouts in seconds: finite, greater than zero, at most 7200.
# Per HTTP/model request (not the complete tool/repair loop).
LLM_REQUEST_TIMEOUT=60
# Whole role calls, including tool loops and at most one schema/citation repair.
# Independent overrides: changing the request timeout does not scale role/run caps.
# Reporter gets 120s for long evidence plus repair; excerpts are not shortened.
# Role/run deadlines still apply; two full 60s requests plus overhead are not guaranteed.
LISTENER_TIMEOUT=60
PLANNER_TIMEOUT=60
RESEARCHER_TIMEOUT=180
REPORTER_TIMEOUT=120
EVALUATOR_TIMEOUT=60
# Total workflow across all revisions.
RUN_TIMEOUT=600
RESEARCH_TEST_MODE=0
# Optional official Apple public documents; no API key. Requires pdftotext for PDF.
RESEARCH_PUBLIC_SOURCES=0
RESEARCH_PDFTOTEXT=
